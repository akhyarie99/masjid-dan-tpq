APP_NAME=SiMasjid
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tpq.smartedugame.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simasjid
DB_USERNAME=simasjid
DB_PASSWORD=

# Redis tersedia di server produksi (Ubuntu). Jika belum diprovision, ganti
# SESSION_DRIVER/QUEUE_CONNECTION/CACHE_STORE ke "database"/"file" seperti di .env lokal.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=tpq.smartedugame.com
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Gateway (Fonnte)
FONNTE_TOKEN=

# Payment Gateway (Midtrans) — pakai kredensial produksi, bukan sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true

# Koordinat default masjid (bisa diubah lagi lewat menu Pengaturan)
MASJID_LATITUDE=
MASJID_LONGITUDE=
